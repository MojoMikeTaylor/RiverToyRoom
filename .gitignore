# River's Toy Room - Git Ignore

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build / temp
node_modules/
dist/
build/
*.log

# Environment / secrets
.env
.env.local
*.pem

# Large media - only ignore if someone drops huge raw footage outside videos/
# We intentionally include short AI-generated clips in videos/ for the site
# *.mp4
# *.mov
# *.webm

# OS generated
*.bak
*.tmp

# Python cache
__pycache__/
*.py[cod]

# Local patch backups
_backup_*/
# Raw / silent / test video material (only finished episodes are published)
videos/batman-van-test*.mp4
videos/batman-extended-silent.mp4
videos/batman-extended/
videos/epic/
videos/battle/
